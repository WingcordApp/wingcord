{
  "name": "wingcord-reports",
  "private": true,
  "type": "module",
  "description": "Bug reports and feature ideas from Wingcord: intake, the Discord inbox, publishing (docs/BUG-REPORTING.md §9).",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit -p . && tsc --noEmit -p test",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
